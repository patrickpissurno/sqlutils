{
  "include": ["./src/**/*.ts"],
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "experimentalDecorators": false,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "allowJs": false,
    "declaration": true,
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "module": "Node16",
    "target": "ESNext",
    "baseUrl": ".",
    "outDir": "./build"
  }
}
